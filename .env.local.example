# Copy this file to .env.local and fill in your values.

# --- Supabase (required) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Facilitator dashboard (optional) --------------------------------------
# Comma-separated emails allowed to see /facilitator (all cohort data).
# Requires SUPABASE_SERVICE_ROLE_KEY below to be set as well.
ADMIN_EMAILS=you@example.com

# --- Payments (optional) ---------------------------------------------------
# Leave these blank to keep the app free — the paywall stays dormant.
# Fill them in to require a one-time payment before anyone can use the app.
#
# STRIPE_SECRET_KEY        Stripe dashboard -> Developers -> API keys (Secret key)
# STRIPE_PRICE_ID          Stripe -> Product catalog -> your product -> Price ID (price_...)
# STRIPE_WEBHOOK_SECRET    Stripe -> Developers -> Webhooks -> your endpoint (whsec_...)
# SUPABASE_SERVICE_ROLE_KEY  Supabase -> Project Settings -> API (service_role key — KEEP SECRET)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your deployed URL, used as a fallback for Stripe redirect links.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
