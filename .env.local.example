# Copy this file to .env.local and fill in your values.

# --- Supabase (required) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI partner for "Solo with AI" mode (optional) -------------------------
# Any OpenAI-compatible chat API. Defaults below are for Groq (free tier).
# Leave AI_API_KEY blank to hide the Solo-with-AI option.
#   Groq key: https://console.groq.com/keys  (free account)
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1     # default (Groq)
# AI_MODEL=llama-3.3-70b-versatile               # default (Groq)
# Other providers (just swap all three):
#   OpenAI  -> https://api.openai.com/v1              gpt-4o-mini
#   Gemini  -> https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.0-flash
#   Anthropic Claude Haiku (cheap, fast) -> https://api.anthropic.com/v1  claude-haiku-4-5-20251001
#   Anthropic Claude Sonnet (higher quality) -> claude-sonnet-4-6 (or newest: claude-sonnet-5)
# NOTE: retired model IDs return 404. Do NOT use claude-3-5-* ids (retired).
#
# Photo Wall analysis uses a separate, vision-capable model (falls back to AI_MODEL):
# AI_VISION_MODEL=claude-sonnet-4-6              # or claude-haiku-4-5-20251001 (also vision-capable, cheaper)
# AI_VISION_BASE_URL=                            # defaults to AI_BASE_URL
# AI_VISION_API_KEY=                             # defaults to AI_API_KEY

# --- Facilitator dashboard (optional) --------------------------------------
# Comma-separated emails allowed to see /facilitator (all cohort data).
# Requires SUPABASE_SERVICE_ROLE_KEY below to be set as well.
ADMIN_EMAILS=you@example.com

# --- Payments (optional) ---------------------------------------------------
# Leave these blank to keep the app free — the paywall stays dormant.
# Fill them in to require a one-time payment before anyone can use the app.
#
# STRIPE_SECRET_KEY        Stripe dashboard -> Developers -> API keys (Secret key)
# STRIPE_PRICE_ID          Stripe -> Product catalog -> your product -> Price ID (price_...)
# STRIPE_WEBHOOK_SECRET    Stripe -> Developers -> Webhooks -> your endpoint (whsec_...)
# SUPABASE_SERVICE_ROLE_KEY  Supabase -> Project Settings -> API (service_role key — KEEP SECRET)
STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID is the ALL-ACCESS bundle price (unlocks every module).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional per-module prices (for selling a single module à la carte).
# If a module's price is unset, it's only available via the all-access bundle.
STRIPE_PRICE_JOB=
STRIPE_PRICE_WORKFLOW=
STRIPE_PRICE_SOLO=

# Optional: your deployed URL, used as a fallback for Stripe redirect links.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Scientifiq.AI (science modules: Domain Expertise Brief). Server-only.
SCIENTIFIQ_API_KEY=
# SCIENTIFIQ_BASE_URL=https://api.scientifiq.ai/api/v1

# BigQuery (Reliance on Science → firms building on the science). Server-only.
# Service account JSON (one line) with BigQuery Data Viewer + Job User.
GOOGLE_CREDENTIALS=
# BQ_PROJECT=com-sci-2
# BQ_ROS_TABLE=com-sci-2.misc.ros_pat_paper_cites_2023_05_29
