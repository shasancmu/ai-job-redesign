# Copy to ml/selfplay/.env and fill in. Load with:  set -a; . ml/selfplay/.env; set +a
# (these are the same values already in the app's .env.local — reuse them.)

# --- proposer (the only thing that costs tokens; use a cheap model) ---
AI_API_KEY=
# Anthropic native (default). For an OpenAI-compatible gateway, set a base ending in /v1.
AI_BASE_URL=https://api.anthropic.com
PROPOSER_MODEL=claude-haiku-4-5-20251001

# --- scorer: free oracle ---
# For commercial / scientific / social (Scientifiq sandbox):
SCIENTIFIQ_API_KEY=
SCIENTIFIQ_BASE_URL=https://api.scientifiq.ai/api/v1

# For defense / complex_invention / interdisciplinary (only with --scorer sciscore):
SCISCORE_URL=
SCISCORE_API_KEY=
